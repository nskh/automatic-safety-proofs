dl_case_study: THEORY

BEGIN

IMPORTING analysis@strategies, dL@top

parabola_dl: LEMMA
LET f: [real -> real] =
            LAMBDA (x_1: real):
              COND x_1 < 0 -> A * 0 ^ 2 / (2 * rv ^ 2),
                   ELSE -> A * x_1 ^ 2 / (2 * rv ^ 2)
              ENDCOND
                      IN
    NOT (((ho - f(ro - 2) - 1 >= 0) AND (ho - f(ro + 2) + 1 <= 0))
          OR ((ho - f(ro - 2) + 1 >= 0) AND (ho - f(ro + 2) - 1 <= 0))
          OR ((ho - f(ro + 2) - 1 >= 0) AND (ho - f(ro - 2) + 1 <= 0))
          OR ((ho - f(ro + 2) + 1 >= 0) AND (ho - f(ro - 2) - 1 <= 0))
          OR ((ro + 2 >= 0) AND
               (ro - 2 <= 0) AND
                (ho - f(0) + 1 >= 0) AND (ho - f(0) - 1 <= 0)))
                                IMPLIES
(((: val(r)=cnst(0) AND val(h)=cnst(0) AND val(v)=cnst(0) AND cnst(rv) > cnst(0) AND cnst(A) >0 :) |-
ALLRUNS(DIFF( (:(r, cnst(rv)), (h, val(v)), (v, cnst(A)):) ),
      DLNOT( cnst(-ro) + val(r) >= cnst(-2) AND
          cnst(-ro) + val(r) <= cnst(2) AND
        -val(h) + cnst(ho) <= cnst(1) AND
        -val(h) + cnst(ho) >= cnst(-1)))))
 
%|- parabola_dl : PROOF
%|- (THEN (BETA) (FLATTEN) (LABEL "goodstuff" (1 2 3 4 5)) (HIDE "goodstuff")
%|-  (SPREAD (DL-SOLVE)
%|-   ((THEN
%|-     (EVAL-EXPR " dlvar_index(r)
%|-                                                                =
%|-                                                                dlvar_index(v)")
%|-     (ASSERT)
%|-     (EVAL-EXPR "dlvar_index(h)
%|-                                                                 =
%|-                                                                 dlvar_index(v)")
%|-     (ASSERT) (EVAL-EXPR " dlvar_index(r) = dlvar_index(h)") (EXPAND "nth" 3)
%|-     (EXPAND "nth" 3) (ASSERT) (EXPAND "nth") (ASSERT) (HIDE 1 2 3) (DL-HIDE -6)
%|-     (GRIND) (LEMMA "ge_ro_case_2_test")
%|-     (SPREAD (INST -1 "ro" "ho" "LAMBDA(x:real): A* x^2 / (2* rv^2)")
%|-      ((THEN (BETA)
%|-        (SPREAD (SPLIT -1)
%|-         ((THEN (ASSERT) (ASSERT) (REVEAL "goodstuff") (ASSERT) (FLATTEN)
%|-           (ASSERT) (SPREAD (SPLIT 1) ((PROPAX) (PROPAX))))
%|-          (THEN (REVEAL "goodstuff") (PROPAX))
%|-          (THEN (REVEAL "goodstuff") (PROPAX))
%|-          (THEN (REVEAL "goodstuff") (PROPAX))
%|-          (THEN (EXPAND "restrict" 1)
%|-           (SPREAD
%|-            (CASE "(LAMBDA (s: (right_open(0))):
%|-              COND s < 0 -> A * 0 ^ 2 / (2 * rv ^ 2),
%|-                   ELSE -> A * s ^ 2 / (2 * rv ^ 2)
%|-              ENDCOND) = LAMBDA (s: (right_open(0))):
%|-              (A/(2*rv*rv))*s^2")
%|-            ((THEN (REPLACE -1)
%|-              (SPREAD (DERIVABLE 1)
%|-               ((THEN (HIDE -) (LEMMA "right_open_dd") (LEMMA "right_open_noe")
%|-                 (INST -1 "0") (INST -2 "0")
%|-                 (SPREAD (LEMMA "id_derivable_fun[(right_open(0))]")
%|-                  ((SPREAD (LEMMA "prod_derivable_fun[(right_open(0))]")
%|-                    ((THEN
%|-                      (INST -1 "LAMBDA (x: (right_open(0))): x"
%|-                       "LAMBDA (x: (right_open(0))): x")
%|-                      (ASSERT)
%|-                      (SPREAD (SPLIT -1)
%|-                       ((THEN (SKEEP) (INST -1 "x") (EXPAND "*" -1) (PROPAX))
%|-                        (PROPAX) (PROPAX))))
%|-                     (THEN (EXPAND "not_one_element?" -2) (ASSERT))
%|-                     (THEN (EXPAND "deriv_domain?" -3) (ASSERT))))
%|-                   (ASSERT) (ASSERT))))
%|-                (THEN (DIV-BY -1 "2") (ASSERT) (DIV-BY -1 "rv") (ASSERT))
%|-                (THEN (HIDE -) (LEMMA "right_open_dd") (INST -1 "0")
%|-                 (LEMMA "right_open_noe") (INST -1 "0")
%|-                 (EXPAND "deriv_domain?" -2) (EXPAND "not_one_element?" -1)
%|-                 (ASSERT) (SPREAD (SPLIT 1) ((PROPAX) (PROPAX))))
%|-                (THEN (LEMMA "right_open_noe") (INST -1 "0"))
%|-                (THEN (LEMMA "right_open_dd") (INST -1 "0")))))
%|-             (THEN (HIDE 2)
%|-              (SPREAD (DECOMPOSE-EQUALITY 1)
%|-               ((THEN (LIFT-IF 1) (TYPEPRED "x!1") (EXPAND "right_open" -1)
%|-                 (ASSERT))
%|-                (THEN (SKEEP) (DIV-BY -1 "2") (DIV-BY -1 "rv") (ASSERT)) (SKEEP)
%|-                (THEN (SKEEP) (DIV-BY -1 "2") (ASSERT) (DIV-BY -1 "rv")
%|-                 (ASSERT))
%|-                (THEN (SKEEP) (DIV-BY -2 "2") (DIV-BY -2 "rv") (ASSERT)))))
%|-             (THEN (SKEEP) (DIV-BY -1 "2") (DIV-BY -1 "rv") (ASSERT)) (SKEEP)
%|-             (THEN (SKEEP) (DIV-BY -1 "2")
%|-              (SPREAD (ASSERT)
%|-               ((THEN (HIDE +) (DIV-BY -1 "rv") (ASSERT))
%|-                (THEN (DIV-BY -1 "rv") (ASSERT))
%|-                (THEN (DIV-BY -1 "rv") (ASSERT)))))
%|-             (THEN (SKEEP) (DIV-BY -2 "2") (DIV-BY -2 "rv") (ASSERT)))))
%|-          (THEN (SKEEP) (EXPAND "restrict" 1)
%|-           (SPREAD
%|-            (CASE "(LAMBDA (s: (right_open(0))):
%|-              COND s < 0 -> A * 0 ^ 2 / (2 * rv ^ 2),
%|-                   ELSE -> A * s ^ 2 / (2 * rv ^ 2)
%|-              ENDCOND) = LAMBDA (s: (right_open(0))):
%|-              (A/(2*rv*rv))*s^2")
%|-            ((THEN (REPLACE -1) (HIDE -1) (LEMMA "right_open_noe")
%|-              (LEMMA "right_open_dd") (INST -1 "0") (INST -2 "0")
%|-              (SPREAD (LEMMA "id_derivable_fun[(right_open(0))]")
%|-               ((SPREAD (LEMMA "prod_derivable_fun[(right_open(0))]")
%|-                 ((THEN
%|-                   (INST -1 "LAMBDA (x: (right_open(0))): x"
%|-                    "LAMBDA (x: (right_open(0))): x")
%|-                   (SPREAD (SPLIT -1)
%|-                    ((SPREAD (LEMMA "scal_derivable_fun[(right_open(0))]")
%|-                      ((THEN (EXPAND "*" -2)
%|-                        (SPREAD
%|-                         (INST -1 "A / (2 * rv * rv)"
%|-                          "LAMBDA (x_1: (right_open(0))) -> real: x_1 * x_1")
%|-                         ((SPREAD (SPLIT -1)
%|-                           ((THEN (EXPAND "*" -1)
%|-                             (SPREAD (LEMMA "deriv_scal_fun[(right_open(0))]")
%|-                              ((SPREAD
%|-                                (INST -1 "A / (2 * rv * rv)"
%|-                                 "LAMBDA (x_1: (right_open(0))) -> real: x_1 * x_1")
%|-                                ((THEN (EXPAND "*" -1 3) (EXPAND "^" 1)
%|-                                  (EXPAND "expt" 1) (EXPAND "expt" 1)
%|-                                  (EXPAND "expt" 1) (REPLACE -1)
%|-                                  (SPREAD (LEMMA "deriv_x_n[(right_open(0))]")
%|-                                   ((THEN
%|-                                     (INST -1
%|-                                      "LAMBDA (x_1: (right_open(0))) -> real: x_1 * x_1"
%|-                                      "2")
%|-                                     (SPREAD (SPLIT -1)
%|-                                      ((THEN (FLATTEN) (REPLACE -2)
%|-                                        (EXPAND "*" 1) (EXPAND "^" 1)
%|-                                        (EXPAND "expt" 1) (EXPAND "expt" 1)
%|-                                        (DIV-BY 1 "2")
%|-                                        (HIDE -1 -2 -3 -4 -5 -6 -7 -8)
%|-                                        (SPREAD (CASE "x=0")
%|-                                         ((ASSERT)
%|-                                          (THEN (TYPEPRED "x")
%|-                                           (EXPAND "right_open" -1)
%|-                                           (GRIND-REALS)))))
%|-                                       (THEN (HIDE-ALL-BUT 1) (ASSERT))
%|-                                       (THEN (HIDE-ALL-BUT 1)
%|-                                        (DECOMPOSE-EQUALITY 1)))))
%|-                                    (THEN (EXPAND "not_one_element?") (ASSERT))
%|-                                    (THEN (EXPAND "deriv_domain?") (ASSERT)))))
%|-                                 (THEN (HIDE-ALL-BUT (-2 1))
%|-                                  (EXPAND "derivable?" -1) (SKEEP)
%|-                                  (INST -1 "x!1") (EXPAND "derivable?" -1)
%|-                                  (EXPAND "convergent?" -1)
%|-                                  (EXPAND "convergence" -1)
%|-                                  (EXPAND "convergence" -1) (EXPAND "adh" -1)
%|-                                  (EXPAND "fullset" -1) (EXPAND "NQ" -1)
%|-                                  (EXPAND "abs" -1) (SKEEP) (INST 1 "l")
%|-                                  (SPREAD (SPLIT 1)
%|-                                   ((PROPAX)
%|-                                    (THEN (SKEEP) (INST -2 "epsilon") (SKEEP)
%|-                                     (INST 1 "delta") (SKEEP) (INST -3 "x2")
%|-                                     (GRIND)))))
%|-                                 (THEN (DIV-BY -1 "2") (DIV-BY -1 "rv")
%|-                                  (HIDE-ALL-BUT (-1 -7)) (ASSERT))))
%|-                               (THEN (HIDE 2) (EXPAND "not_one_element?")
%|-                                (ASSERT))
%|-                               (THEN (EXPAND "deriv_domain?") (ASSERT)))))
%|-                            (PROPAX)))
%|-                          (THEN (DIV-BY -1 "2") (DIV-BY -1 "rv") (ASSERT)))))
%|-                       (THEN (EXPAND "not_one_element?") (ASSERT))
%|-                       (THEN (EXPAND "deriv_domain?") (ASSERT))))
%|-                     (PROPAX) (PROPAX))))
%|-                  (THEN (EXPAND "not_one_element?") (ASSERT))
%|-                  (THEN (EXPAND "deriv_domain?") (ASSERT))))
%|-                (THEN (EXPAND "not_one_element?") (ASSERT))
%|-                (THEN (EXPAND "deriv_domain?") (ASSERT)))))
%|-             (THEN (HIDE 2)
%|-              (SPREAD (DECOMPOSE-EQUALITY 1)
%|-               ((THEN (TYPEPRED "x!1") (EXPAND "right_open" -1) (ASSERT))
%|-                (THEN (HIDE 2) (SKEEP) (DIV-BY -1 "2") (DIV-BY -1 "rv")
%|-                 (ASSERT))
%|-                (SKEEP) (THEN (SKEEP) (DIV-BY -1 "2") (DIV-BY -1 "rv") (ASSERT))
%|-                (THEN (SKEEP) (DIV-BY -2 "2") (DIV-BY -2 "rv") (ASSERT)))))
%|-             (THEN (SKEEP) (DIV-BY -1 "2") (DIV-BY -1 "rv") (ASSERT)) (SKEEP)
%|-             (THEN (SKEEP) (DIV-BY -1 "2") (DIV-BY -1 "rv") (ASSERT))
%|-             (THEN (SKEEP) (DIV-BY -2 "2") (DIV-BY -2 "rv") (ASSERT)))))
%|-          (THEN (INST 1 "rv*t") (ASSERT) (LIFT-IF 1)
%|-           (SPREAD (SPLIT 1)
%|-            ((THEN (FLATTEN) (DIV-BY -1 "rv") (ASSERT))
%|-             (THEN (FLATTEN) (ASSERT))))))))
%|-       (SPREAD (DIV-BY -1 "rv*rv")
%|-        ((ASSERT) (THEN (DIV-BY -1 "rv") (ASSERT)))))))
%|-    (THEN (HIDE 3) (ASSERT) (EXPAND "length" 2) (EXPAND "length" 2)
%|-     (EXPAND "length" 2) (EXPAND "length" 2)
%|-     (EVAL-EXPR "dlvar_index(h) = dlvar_index(v)") (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (HIDE 3) (EVAL-EXPR 2) (ASSERT))
%|-    (THEN (REVEAL +) (HIDE-ALL-BUT 1) (INST 1 "A")
%|-     (EVAL-EXPR "dlvar_index(h) = dlvar_index(v)")
%|-     (EVAL-EXPR "dlvar_index(r) = dlvar_index(v)") (ASSERT) (EXPAND "nth" 3)
%|-     (EXPAND "nth" 3) (EXPAND "nth" 3) (PROPAX)))))
%|- QED parabola_dl

END dl_case_study